# FloraFarm Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Google Gemini AI (required for the Agri-Advisor chat) ──────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides ─────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-1.5-flash   # or gemini-1.5-pro for more powerful responses
